# Puerto HTTP local. Railway lo asigna automáticamente mediante PORT.
PORT=4000

# Base de datos MySQL local. En Railway se admiten como alternativa MYSQLHOST,
# MYSQLPORT, MYSQLUSER, MYSQLPASSWORD y MYSQLDATABASE.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=riegar_db

# Autenticación JWT
JWT_SECRET=

# Cuenta que recibe los mensajes del formulario de contacto
EMAIL_USER=
EMAIL_PASS=

# Se pueden indicar varios orígenes separados por comas.
CORS_ORIGIN=http://localhost:5173
