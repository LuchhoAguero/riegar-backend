# Puerto HTTP del backend.
PORT=4000

# MySQL: completar con los datos de Aiven en el entorno actual.
# Para desarrollo local, usar los datos de una instancia MySQL local.
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD y MYSQLDATABASE siguen
# admitidas como compatibilidad histórica con Railway.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=riegar_db

# Aiven: DB_SSL=true y ruta local al CA descargado de Aiven.
# MySQL local sin TLS: DB_SSL=false; DB_SSL_CA_PATH puede quedar vacío.
# Nunca versionar el CA ni colocarlo en este archivo.
DB_SSL=false
DB_SSL_CA_PATH=

# Autenticación JWT
JWT_SECRET=

# Cuenta que recibe los mensajes del formulario de contacto
EMAIL_USER=
EMAIL_PASS=

# Se pueden indicar varios orígenes separados por comas.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
